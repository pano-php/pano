<IfModule mod_rewrite.c>
    RewriteEngine On

    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    <IfModule mod_headers.c>
        RequestHeader append X-Forwarded-For "%{REMOTE_ADDR}s"
    </IfModule>

    # Preserve Authorization header (JWT / Bearer)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Remove trailing slash (if not a directory)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)/$ /$1 [R=301,L]

    # Block direct access to any .php or .html file except index.php
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(?!index\.php$).+\.(php|html)$ - [F,L]

    # Serve existing non-PHP/non-HTML files and directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Otherwise forward to Front Controller
    RewriteRule ^ index.php [L]
</IfModule>